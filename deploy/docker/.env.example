# NasDSH Docker 部署配置示例：复制为 .env 后按需修改
# cp .env.example .env && vim .env

# ---- 镜像 ----
# 本地构建: docker build -t nasdsh:0.1.0 -f core/Dockerfile core
# 离线导入: docker load -i nasdsh-0.1.0-docker-amd64.tar.gz
NASDSH_VERSION=0.1.0

# ---- 端口 ----
# 宿主访问端口（容器内固定 8080）
NASDSH_PORT=12704

# ---- 路径 ----
# 持久数据目录（dsh profile/凭据/会话/日志），建议 SSD 数据卷
DATA_PATH=/vol1/docker/nasdsh/data
# 项目根目录（容器内外同路径；多个项目建在其下，UI 内用 Workspace 切换）
PROJECTS_PATH=/vol1/docker/nasdsh/projects

# ---- 项目根白名单 ----
# 允许新建工作台时选择的根目录，冒号分隔；留空=自动探测 /volume* 与 /home
# fnOS 常见: /vol1 ；UGOS 常见: /volume1:/volume2
NASDSH_ROOTS=

# 共享 Web 默认工作目录（留空=第一个允许根）
NASDSH_WEB_CWD=

# ---- 访问与凭据（均可留空）----
# 访问口令：设置后打开工作台需要输入（远程访问建议设置）
TERM_PIN=
# 反代/远程域名（逗号分隔），例如 UGREENlink 域名
NASDSH_TRUSTED_HOSTS=
# 模型 API Key
DEEPSEEK_API_KEY=
BIGMODEL_API_KEY=
BAILIAN_API_KEY=
TOKENPLAN_API_KEY=

TZ=Asia/Shanghai
